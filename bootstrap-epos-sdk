#!/usr/bin/env bash
# shellcheck shell=bash
set -Eeuo pipefail
export LC_ALL=C
readonly TOOL_VERSION=1.0.0
CURRENT_STAGE=arguments
resolve_project_dir() {
  local src=${BASH_SOURCE[0]} dir
  while [[ -L $src ]]; do
    dir=$(cd -P -- "$(dirname -- "$src")" && pwd)
    src=$(readlink -- "$src")
    [[ $src == /* ]] || src=$dir/$src
  done
  cd -P -- "$(dirname -- "$src")" && pwd
}
PROJECT_DIR=$(resolve_project_dir)
readonly PROJECT_DIR
# shellcheck source=lib/log.sh
source "$PROJECT_DIR/lib/log.sh"
on_error() { local rc=$1; log_error "${CURRENT_STAGE}: failed with exit ${rc}"; exit "$rc"; }
trap 'on_error "$?"' ERR
usage() {
  cat <<HELP
bootstrap-epos-sdk $TOOL_VERSION
Usage: bootstrap-epos-sdk [FLAGS] install|verify|uninstall [FLAGS]

  install    Install the pinned EPOS Linux Library 6.8.1.0.
  verify     Check installation and native loading, without controller calls.
  uninstall  Remove owned files and configuration.

  --sdk-dir PATH, --sdk-dir=PATH  Override EPOS_SDK_DIR or the default
                                \$HOME/workspace/upstream/epos-sdk.
  --dry-run                     Read-only plan; no locks or native loading.
  --yes, -y                     Skip confirmation. For install this also
                                accepts maxon's license acknowledgement.
  --help, -h                    Show this help, without host checks.
  --                            End option parsing.

No arguments shows help. Real install and uninstall require an ordinary user.
The SDK EULA is retained at <prefix>/vendor/EPOS_Linux_Library/EULA.txt.
HELP
}
invalid() { log_error "$*"; exit 2; }
command_name='' sdk_dir='' sdk_set=0 dry=0 yes=0 help=0 ended=0
argc=$#
while (($#)); do
  case $1 in
    install|verify|uninstall)
      [[ -z $command_name || $command_name == "$1" ]] || invalid 'Conflicting commands'
      command_name=$1 ;;
    *)
      ((ended == 0)) || invalid "Unexpected argument: $1"
      case $1 in
        --) ended=1 ;;
        --help|-h) help=1 ;;
        --dry-run) dry=1 ;;
        --yes|-y) yes=1 ;;
        --sdk-dir)
          if (($# < 2)); then invalid '--sdk-dir requires a non-empty path'; fi
          if [[ -z ${2//[[:space:]]/} || $2 == -* ]]; then invalid '--sdk-dir requires a non-empty path'; fi
          shift; sdk_dir=$1; sdk_set=1 ;;
        --sdk-dir=*) sdk_dir=${1#*=}; [[ -n ${sdk_dir//[[:space:]]/} ]] || invalid '--sdk-dir requires a non-empty path'; sdk_set=1 ;;
        *) invalid "Unknown argument: $1" ;;
      esac ;;
  esac
  shift
done
if ((help || argc == 0)); then usage; exit 0; fi
[[ -n $command_name ]] || invalid 'A command is required'
((BASH_VERSINFO[0] >= 5)) || invalid 'host: Bash 5 or newer is required'
if [[ ${EPOS_SDK_DIR+x} && -z ${EPOS_SDK_DIR//[[:space:]]/} ]]; then invalid 'EPOS_SDK_DIR must not be empty'; fi
if ((sdk_set == 0)); then sdk_dir=${EPOS_SDK_DIR-${HOME}/workspace/upstream/epos-sdk}; fi
[[ -x /usr/bin/python3 ]] || invalid 'host: /usr/bin/python3 is required'
CURRENT_STAGE=$command_name
# JSON pins are data, never shell input. There is no persistent run-log directory.
# shellcheck source=lib/common.sh
source "$PROJECT_DIR/lib/common.sh"
run_bootstrap "$command_name" "$sdk_dir" "$dry" "$yes" "$TOOL_VERSION"
